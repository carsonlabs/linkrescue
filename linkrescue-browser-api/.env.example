# Port the API server listens on
PORT=3847

# Shared secret — the Next.js app sends this in the x-api-key header
API_SECRET=change-me-to-a-long-random-string

# Origin allowed for CORS (your Vercel deployment URL)
ALLOWED_ORIGIN=https://linkrescue.io

# --- Consumers (set these in the CONSUMER's env, e.g. Vercel, not here) ---
# The web app (/api/check-link/browser) and the crawler's tier-3 headless
# fallback both reach this service via:
#   BROWSER_API_URL   = https://<this-service-host>   (no trailing slash)
#   BROWSER_API_KEY   = <same value as API_SECRET above>
# Unset on the consumer = headless tier is simply skipped (tiers 1-2 only).
